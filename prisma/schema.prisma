generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  company   String?  @db.VarChar(150)
  email     String   @db.VarChar(254)
  phone     String   @db.VarChar(20)
  service   String   @db.VarChar(100)
  message   String
  status    String   @default("NEW") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([service])
  @@index([status])
  @@index([createdAt])
  @@map("contact_enquiries")
}

model ConsultationRequest {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(100)
  company       String?  @db.VarChar(150)
  email         String   @db.VarChar(254)
  phone         String   @db.VarChar(20)
  topic         String   @db.VarChar(100)
  preferredDate DateTime @db.Date
  preferredTime String   @db.VarChar(30)
  message       String
  status        String   @default("NEW") @db.VarChar(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([topic])
  @@index([status])
  @@index([preferredDate])
  @@index([createdAt])
  @@map("consultation_requests")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(100)
  role         String   @default("USER") @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}
model BlogPost {
  id            String    @id @default(cuid())
  title         String    @db.VarChar(200)
  slug          String    @unique @db.VarChar(220)
  excerpt       String?   @db.VarChar(500)
  content       String
  coverImage    String?   @db.VarChar(500)
  category      String?   @db.VarChar(100)
  authorId      String?
  status        String    @default("DRAFT") @db.VarChar(20)
  publishedAt   DateTime?
  seoTitle      String?   @db.VarChar(200)
  seoDescription String?  @db.VarChar(320)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("blog_posts")
}