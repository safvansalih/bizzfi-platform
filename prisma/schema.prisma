generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactEnquiry {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(100)
  company        String?   @db.VarChar(150)
  email          String    @db.VarChar(254)
  phone          String    @db.VarChar(20)
  service        String    @db.VarChar(100)
  message        String
  status         String    @default("NEW") @db.VarChar(30)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  odooLeadId     Int?
  odooSyncError  String?
  odooSyncStatus String?
  odooSyncedAt   DateTime?

  @@index([email])
  @@index([service])
  @@index([status])
  @@index([createdAt])
  @@map("contact_enquiries")
}

model ConsultationRequest {
  id              String            @id @default(cuid())
  name            String            @db.VarChar(100)
  company         String?           @db.VarChar(150)
  email           String            @db.VarChar(254)
  phone           String            @db.VarChar(20)
  topic           String            @db.VarChar(100)
  preferredDate   DateTime          @db.Date
  preferredTime   String            @db.VarChar(30)
  message         String
  status          String            @default("NEW") @db.VarChar(30)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  nextFollowUpAt  DateTime?
  followUpNote    String?
  reminderSentAt  DateTime?
  odooLeadId      Int?
  odooSyncError   String?
  odooSyncStatus  String?
  odooSyncedAt    DateTime?
  followUpHistory FollowUpHistory[]

  @@index([email])
  @@index([topic])
  @@index([status])
  @@index([preferredDate])
  @@index([createdAt])
  @@map("consultation_requests")
}

model FollowUpHistory {
  id             String              @id @default(cuid())
  consultationId String
  followUpAt     DateTime?
  note           String?
  completedAt    DateTime            @default(now())
  consultation   ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([completedAt])
  @@map("follow_up_history")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(100)
  role         String   @default("USER") @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String    @db.VarChar(200)
  slug           String    @unique @db.VarChar(220)
  excerpt        String?   @db.VarChar(500)
  content        String
  coverImage     String?   @db.VarChar(500)
  category       String?   @db.VarChar(100)
  authorId       String?
  status         String    @default("DRAFT") @db.VarChar(20)
  publishedAt    DateTime?
  seoTitle       String?   @db.VarChar(200)
  seoDescription String?   @db.VarChar(320)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("blog_posts")
}

model MetaAdForm {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  campaignName String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fields      MetaAdFormField[]
  submissions MetaAdFormSubmission[]

  @@map("meta_ad_forms")
}

model MetaAdFormField {
  id        String   @id @default(cuid())
  formId    String
  label     String
  fieldKey  String
  fieldType String   @default("text")
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  options   Json?
  createdAt DateTime @default(now())

  form              MetaAdForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  metaAdFormAnswers MetaAdFormAnswer[]

  @@unique([formId, fieldKey])
  @@map("meta_ad_form_fields")
}

model MetaAdFormSubmission {
  id         String   @id @default(cuid())
  formId     String
  metaLeadId String?
  fullName   String?
  email      String?
  phone      String?
  rawPayload Json?
  createdAt  DateTime @default(now())

  form    MetaAdForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers MetaAdFormAnswer[]

  @@map("meta_ad_form_submissions")
}

model MetaAdFormAnswer {
  id           String  @id @default(cuid())
  submissionId String
  fieldId      String
  value        String?

  submission MetaAdFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      MetaAdFormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@map("meta_ad_form_answers")
}
